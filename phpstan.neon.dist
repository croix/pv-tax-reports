includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- src
		- pv-tax-reports.php
		- uninstall.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
		- tests/stubs/action-scheduler.php
	treatPhpDocTypesAsCertain: false
